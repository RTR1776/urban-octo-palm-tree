## Data Quality & Filtering Strategy

### Problem: Noisy Data
Current issues:
- Small trades ($1-$50) clutter the feed
- Crypto markets dominate volume
- Inactive markets show up in lists
- Spam/test markets exist

### Solution: Multi-Layer Filtering

#### Backend Filtering (Server-Side)
```typescript
interface MarketFilter {
  minVolume24h?: number;        // Default: $1000
  minLiquidity?: number;         // Default: $500
  minTradeSize?: number;         // Default: $500 for trades
  excludeCategories?: string[];  // ['crypto', 'test']
  activeOnly?: boolean;          // Default: true
  minTraderCount?: number;       // Default: 5
}

class DataFilter {
  static filterMarkets(markets: Market[], filter: MarketFilter): Market[] {
    return markets.filter(m => {
      if (filter.minVolume24h && m.volume < filter.minVolume24h) return false;
      if (filter.minLiquidity && m.liquidity < filter.minLiquidity) return false;
      if (filter.activeOnly && !m.active) return false;
      if (filter.excludeCategories) {
        const categories = this.detectCategories(m.question);
        if (categories.some(cat => filter.excludeCategories!.includes(cat))) return false;
      }
      return true;
    });
  }

  static filterTrades(trades: Trade[], filter: MarketFilter): Trade[] {
    return trades.filter(t => {
      const value = t.size * t.price;
      if (filter.minTradeSize && value < filter.minTradeSize) return false;
      if (filter.excludeCategories) {
        const categories = this.detectCategories(t.title || '');
        if (categories.some(cat => filter.excludeCategories!.includes(cat))) return false;
      }
      return true;
    });
  }

  private static detectCategories(text: string): string[] {
    const lower = text.toLowerCase();
    const categories: string[] = [];

    if (this.containsAny(lower, ['bitcoin', 'btc', 'ethereum', 'eth', 'crypto', 'solana'])) {
      categories.push('crypto');
    }
    if (this.containsAny(lower, ['test', 'example', 'demo'])) {
      categories.push('test');
    }
    if (this.containsAny(lower, ['trump', 'biden', 'election', 'president'])) {
      categories.push('politics');
    }
    // ... more categories

    return categories;
  }

  private static containsAny(text: string, keywords: string[]): boolean {
    return keywords.some(kw => text.includes(kw));
  }
}
```

#### Frontend Filtering (User Controls)
```typescript
// User preferences stored in localStorage or backend

## Technical Implementation Details

### Backend Patterns

#### 1. Service Layer Architecture
```typescript
// analytics/market-analyzer.ts
export class MarketAnalyzer {
  async calculateMetrics(marketId: string, timeframe: string): Promise<MarketMetrics> {
    const priceHistory = await this.db.getPriceHistory(marketId, timeframe);
    return {
      volatility: this.calculateVolatility(priceHistory),
      momentum: this.calculateMomentum(priceHistory),
      sharpeRatio: this.calculateSharpe(priceHistory),
      // ... more metrics
    };
  }

  private calculateVolatility(prices: PricePoint[]): number {
    // Standard deviation of returns
    const returns = prices.map((p, i) => i > 0 ? (p.close - prices[i-1].close) / prices[i-1].close : 0);
    const mean = returns.reduce((sum, r) => sum + r, 0) / returns.length;
    const variance = returns.reduce((sum, r) => sum + Math.pow(r - mean, 2), 0) / returns.length;
    return Math.sqrt(variance);
  }

  private calculateMomentum(prices: PricePoint[]): number {
    // Rate of change over period
    if (prices.length < 2) return 0;
    const oldPrice = prices[0].close;
    const newPrice = prices[prices.length - 1].close;
    return ((newPrice - oldPrice) / oldPrice) * 100;
  }
}
```

#### 2. Caching Strategy
```typescript
// aggregation/cache-manager.ts
export class CacheManager {
  private cache: Map<string, { data: any; expiry: number }> = new Map();

  async get<T>(key: string, fetcher: () => Promise<T>, ttlSeconds: number = 300): Promise<T> {
    const cached = this.cache.get(key);
    if (cached && cached.expiry > Date.now()) {
      return cached.data as T;
    }

    const data = await fetcher();
    this.cache.set(key, { data, expiry: Date.now() + ttlSeconds * 1000 });
    return data;
  }
}
```

#### 3. Background Jobs
```typescript
// jobs/historical-data-updater.ts
import cron from 'node-cron';

export function scheduleHistoricalDataJobs(client: PolymarketClient, db: DatabaseService) {
  // Update 1-hour candles every hour
  cron.schedule('0 * * * *', async () => {
    console.log('[CRON] Updating 1-hour price history');
    const markets = await client.getMarkets(100, true);
    for (const market of markets) {
      const history = await client.getPriceHistory(market.id, '1h');
      await db.storePriceHistory(market.id, history, '1h');
    }
  });

  // Update 5-minute candles every 5 minutes
  cron.schedule('*/5 * * * *', async () => {
    console.log('[CRON] Updating 5-minute price history');
    const activeMarkets = await client.getVolumeLeaders(50);
    for (const market of activeMarkets) {
      const history = await client.getPriceHistory(market.id, '5m');
      await db.storePriceHistory(market.id, history, '5m');
    }
  });

  // Recalculate market metrics every 15 minutes
  cron.schedule('*/15 * * * *', async () => {
    console.log('[CRON] Recalculating market metrics');
    const analyzer = new MarketAnalyzer(db);
    const markets = await db.getAllActiveMarketIds();
    for (const marketId of markets) {
      const metrics = await analyzer.calculateMetrics(marketId, '24h');
      await db.storeMarketMetrics(marketId, metrics);
    }
  });
}
```

### Frontend Patterns

#### 1. Custom Hooks for Data Fetching
```typescript
// hooks/useMarketMetrics.ts
export function useMarketMetrics(marketId: string) {
  const [metrics, setMetrics] = useState<MarketMetrics | null>(null);
  const [loading, setLoading] = useState(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    async function fetchMetrics() {
      try {
        setLoading(true);
        const data = await api.getMarketMetrics(marketId);
        setMetrics(data);
      } catch (err) {
        setError(err.message);
      } finally {
        setLoading(false);
      }
    }
    fetchMetrics();
  }, [marketId]);

  return { metrics, loading, error };
}
```

#### 2. Chart Component Pattern
```typescript
// components/charts/CandlestickChart.tsx
import { ResponsiveContainer, ComposedChart, Bar, Line, XAxis, YAxis, Tooltip } from 'recharts';

interface CandlestickChartProps {
  data: OHLCVData[];
  height?: number;
  showVolume?: boolean;
}

export function CandlestickChart({ data, height = 400, showVolume = true }: CandlestickChartProps) {
  return (
    <ResponsiveContainer width="100%" height={height}>
      <ComposedChart data={data}>
        <XAxis dataKey="timestamp" tickFormatter={(ts) => formatTime(ts)} />
        <YAxis yAxisId="price" domain={['dataMin', 'dataMax']} />
        {showVolume && <YAxis yAxisId="volume" orientation="right" />}
        <Tooltip content={<CustomCandlestickTooltip />} />

        {/* Candlestick bodies */}
        <Bar yAxisId="price" dataKey="candlestick" shape={<CandlestickShape />} />

        {/* Volume bars */}
        {showVolume && (
          <Bar yAxisId="volume" dataKey="volume" fill="#8884d8" opacity={0.3} />
        )}
      </ComposedChart>
    </ResponsiveContainer>
  );
}
```

#### 3. State Management (Context API or Zustand)
```typescript
// store/analyticsStore.ts
import create from 'zustand';

interface AnalyticsState {
  selectedMarkets: string[];
  timeRange: TimeRange;
  selectedCategories: string[];
  addMarket: (marketId: string) => void;
  removeMarket: (marketId: string) => void;
  setTimeRange: (range: TimeRange) => void;
  toggleCategory: (category: string) => void;
}

export const useAnalyticsStore = create<AnalyticsState>((set) => ({
  selectedMarkets: [],
  timeRange: '24h',
  selectedCategories: [],

  addMarket: (marketId) =>
    set((state) => ({ selectedMarkets: [...state.selectedMarkets, marketId] })),

  removeMarket: (marketId) =>
    set((state) => ({ selectedMarkets: state.selectedMarkets.filter(id => id !== marketId) })),

  setTimeRange: (range) => set({ timeRange: range }),

  toggleCategory: (category) =>
    set((state) => ({
      selectedCategories: state.selectedCategories.includes(category)
        ? state.selectedCategories.filter(c => c !== category)
        : [...state.selectedCategories, category]
    })),
}));
```


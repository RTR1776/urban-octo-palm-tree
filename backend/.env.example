PORT=3001
NODE_ENV=development

# Polymarket API endpoints
GAMMA_API_URL=https://gamma-api.polymarket.com
CLOB_API_URL=https://clob.polymarket.com
DATA_API_URL=https://data-api.polymarket.com
WS_API_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market

# Kalshi API (optional - enable Kalshi monitoring)
KALSHI_ENABLED=false
KALSHI_API_URL=https://trading-api.kalshi.com/trade-api/v2
KALSHI_EMAIL=
KALSHI_PASSWORD=

# Monitoring settings
WHALE_THRESHOLD=10000
LARGE_MOVEMENT_THRESHOLD=5000
UNUSUAL_VOLUME_MULTIPLIER=3
CHECK_INTERVAL_SECONDS=60

# Enhanced monitor (recommended)
USE_ENHANCED_MONITOR=true

# Database
DB_PATH=./data/polymarket.db

# Notifications
NOTIFICATIONS_ENABLED=false
NOTIFICATION_WEBHOOK=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
NOTIFICATION_EMAIL=
NOTIFICATION_PHONE=
